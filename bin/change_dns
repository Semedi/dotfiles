#!/usr/bin/env bash
# change-dns.sh
# Simple script to change DNS in NetworkManager and restart service

set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: $0 <DNS_IP>"
  exit 1
fi

DNS_IP="$1"

echo "==> Setting DNS to $DNS_IP"

# Cambiar el DNS global de NetworkManager
nmcli general logging level INFO domains DNS
nmcli general reload
nmcli general permissions > /dev/null 2>&1

connection_name=$(nmcli -t -f NAME connection show --active| head -n 1)


# Configurar el DNS
nmcli connection modify "$connection_name" ipv4.ignore-auto-dns yes
nmcli connection modify "$connection_name" ipv4.dns "$DNS_IP"

# Reiniciar la conexión activa
nmcli connection down "$connection_name" || true
nmcli connection up "$connection_name"

# Reiniciar NetworkManager (por si acaso)
sudo systemctl restart NetworkManager

echo "==> DNS set to $DNS_IP successfully!"
